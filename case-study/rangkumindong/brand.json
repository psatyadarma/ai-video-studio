  "repeat": "rows are explicit through 2026-11-21 (each hook pair twice, sides swapped). After that the Sunday review sets the next block.",
  "trial_reels": "daily: A = main post (IG+YouTube+TikTok); B = same video, only the opening differs (hook_b style), posted to Instagram only as a Trial Reel (engine/variant.py + post.py --trial). Compare A vs B on IG 3-s hold and avg % watched.",
  "primary_metric": "avg_percent_watched",
  "review": "weekly, Sunday",
  "format_rules": {
   "standard": "current sticker explainer, 60-90 s",
   "short": "30-45 s, ~80-110 spoken words: hook, tagline, 2-3 beats, CTA; one zone per 5-8 s",
   "chapter_cut": "Saturday: a Short cut from the weekly video (not part of the format test)",
   "minggu_depan": "Sunday: week-ahead Short (not part of the format test)"
  },
  "hook_styles": {
   "question_reveal": "question whose answer is a number held back to the end (Semenit Ilmu style), big 2-line title card",
   "shock_number": "the most surprising verified number + why it matters, in one line",
   "kamu_stakes": "direct 'kamu' stakes: what it changes for the viewer ('Cicilan kamu naik?')",
   "myth": "'Katanya X. Ternyata Y.' — a common belief, then the twist",
   "person_collage": "real-person cut-out in the collage look (tests/hook-collage); needs a licensed face, else use the next style and log it",
   "story": "cold open on a person in a scene, mid-action, no context first ('Jumat pagi, layar Pak Budi merah semua…'); the news arrives through what happens to them"
  }
